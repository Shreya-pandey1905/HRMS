USE Pulse360Db;

DROP TABLE IF EXISTS generated_letters;

CREATE TABLE generated_letters (
    GeneratedLetterId INT NOT NULL AUTO_INCREMENT,
    UserId INT NOT NULL,
    LetterName VARCHAR(255) NOT NULL,
    LetterFile VARCHAR(500) NOT NULL,
    GeneratedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (GeneratedLetterId),

    CONSTRAINT FK_GeneratedLetter_User
        FOREIGN KEY (UserId)
        REFERENCES User(UserId)
        ON DELETE CASCADE
);

DROP PROCEDURE IF EXISTS AddGeneratedLetter;
DELIMITER $$

CREATE PROCEDURE AddGeneratedLetter(
    IN p_userId INT,
    IN p_letterName VARCHAR(255),
    IN p_letterFile VARCHAR(500)
)
BEGIN

    INSERT INTO generated_letters
    (
        UserId,
        LetterName,
        LetterFile
    )
    VALUES
    (
        p_userId,
        p_letterName,
        p_letterFile
    );

END$$

