DELIMITER $$

-- 1. Assign a document to an employee
CREATE PROCEDURE AssignEmployeeDocument(
    IN p_userId INT,
    IN p_documentId INT
)
BEGIN
    INSERT INTO employee_document_assignments
        (UserId, DocumentId, Status)
    VALUES
        (p_userId, p_documentId, 'PENDING');
END$$


-- 2. Get all pending documents for an employee
CREATE PROCEDURE GetPendingEmployeeDocuments(
    IN p_userId INT
)
BEGIN
    SELECT
        a.AssignmentId,
        a.UserId,
        a.DocumentId,
        d.DocName,
        a.Status,
        a.AssignedAt
    FROM employee_document_assignments a
    INNER JOIN addemployeedocnames d
        ON a.DocumentId = d.Id
    WHERE a.UserId = p_userId
      AND a.Status = 'PENDING'
    ORDER BY a.AssignedAt DESC;
END$$


-- 3. Add an employee uploaded document
CREATE PROCEDURE AddEmployeeDocument(
    IN p_fileName VARCHAR(255),
    IN p_filePath VARCHAR(500),
    IN p_userId INT,
    IN p_documentId INT
)
BEGIN
    INSERT INTO fileuploads
        (FileName, FilePath, UserId, DocumentId)
    VALUES
        (p_fileName, p_filePath, p_userId, p_documentId);
END$$


-- 4. Mark the assigned document as submitted
CREATE PROCEDURE MarkEmployeeDocumentSubmitted(
    IN p_userId INT,
    IN p_documentId INT
)
BEGIN
    UPDATE employee_document_assignments
    SET
        Status = 'SUBMITTED',
        SubmittedAt = CURRENT_TIMESTAMP
    WHERE UserId = p_userId
      AND DocumentId = p_documentId
      AND Status = 'PENDING';
END$$


-- 5. Get employee's uploaded documents
CREATE PROCEDURE GetEmployeeDocuments(
    IN p_userId INT
)
BEGIN
    SELECT
        f.id,
        f.FileName,
        f.FilePath,
        f.UserId,
        f.DocumentId,
        d.DocName
    FROM fileuploads f
    LEFT JOIN addemployeedocnames d
        ON f.DocumentId = d.Id
    WHERE f.UserId = p_userId
    ORDER BY f.id DESC;
END$$


-- 6. Get all employee documents for Admin
CREATE PROCEDURE GetAllEmployeeDocuments()
BEGIN
    SELECT
        f.id,
        f.FileName,
        f.FilePath,
        f.UserId,
        f.DocumentId,
        d.DocName,
        u.FirstName,
        u.LastName,
        u.Email
    FROM fileuploads f
    LEFT JOIN addemployeedocnames d
        ON f.DocumentId = d.Id
    INNER JOIN user u
        ON f.UserId = u.UserId
    ORDER BY f.id DESC;
END$$


-- 7. Delete an employee uploaded document
CREATE PROCEDURE DeleteEmployeeDocument(
    IN p_id INT
)
BEGIN
    DELETE FROM fileuploads
    WHERE id = p_id;
END$$

