DELIMITER $$

CREATE PROCEDURE GetEmployeeCompanyLetters(
    IN p_userId INT
)
BEGIN

    SELECT
        g.GeneratedLetterId,
        g.UserId,
        g.LetterName,
        g.LetterFile,
        g.GeneratedDate

    FROM generated_letters g

    WHERE g.UserId = p_userId

    ORDER BY g.GeneratedLetterId DESC;

END$$

